{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "pi-agent 桌面壳最小能力：核心事件/窗口/自定义命令 + 系统通知",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-show",
    "core:window:allow-hide",
    "core:window:allow-set-focus",
    "core:event:default",
    "notification:default"
  ]
}
